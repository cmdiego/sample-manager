{
  "name": "Search finds a nested filename substring and click exits typing",
  "steps": [
    {"event": "key", "key": "/"},
    {"event": "type_search", "text": "NAR"},
    {"assert": "visible_rows", "names": ["snare.wav — drums"]},
    {"assert": "filter", "has_focus": true, "text": "NAR"},
    {"event": "click_browser"},
    {"assert": "filter", "has_focus": false, "text": "NAR"},
    {"event": "key", "key": "Escape"},
    {"assert": "visible_rows", "names": ["drums"]},
    {"assert": "filter", "has_focus": false, "text": ""}
  ]
}
