/* One accent marks interaction; neutral borders let filenames dominate. */
Screen {
    layers: base overlay;
}

#library-header {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text;
    text-style: bold;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

/* A fixed compact preview leaves the remaining rows available for browsing. */
TopDisplayWidget {
    border: round $panel-lighten-2;
    border-title-color: $text;
    height: 7;
    padding: 0 1;
    overflow: hidden hidden;
}
TopDisplayWidget .meta-row {
    height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}
TopDisplayWidget .meta-label { color: $text-muted; }
TopDisplayWidget .waveform-display {
    height: 4;
    width: 1fr;
    color: $accent;
}
.compact TopDisplayWidget { height: 6; }
.compact TopDisplayWidget .waveform-display { height: 3; }

#main-grid {
    layout: grid;
    grid-size: 2 1;
    grid-columns: 2fr 1fr;
    grid-rows: 1fr;
    height: 1fr;
}
.narrow #main-grid { grid-columns: 1fr 28; }

BrowserZone, SelectedFilesListWidget {
    border: round $panel-lighten-2;
    border-title-color: $text-muted;
    height: 1fr;
    padding: 0 1;
}
BrowserZone { layout: vertical; }
TopDisplayWidget.active-pane, BrowserZone.active-pane, SelectedFilesListWidget.active-pane {
    border: round $accent;
    border-title-color: $accent;
}
FiltersPanel {
    height: 1;
    margin-bottom: 1;
    color: $text-muted;
}
FiltersPanel.search-active {
    background: $boost;
    color: $accent;
}
FiltersPanel Static {
    height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}
SampleListWidget {
    border: none;
    height: 1fr;
    padding: 0;
}
SampleListWidget .file-row, SelectedFilesListWidget .sel-item {
    height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}
/* An inactive Browser retains its cursor without competing with Stage focus. */
.cursor-row { background: $boost; }
.active-pane .cursor-row {
    background: $accent;
    color: $background;
    text-style: bold;
}
SelectedFilesListWidget .sel-hint {
    height: auto;
    color: $text-muted;
    margin-top: 1;
}

#status-bar, #shortcut-bar {
    height: 1;
    padding: 0 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}
#status-bar { color: $text-muted; }
#shortcut-bar { background: $panel; color: $text; }

/* Share dialog framing while preserving each screen's dimensions/scrolling. */
ActionPane Vertical, HelpScreen .help-container,
#tui-settings, #add-library-dialog, #sample-tags-dialog, #commands-dialog {
    border: round $accent;
    background: $surface;
}
HelpScreen { align: center middle; }
HelpScreen .help-container {
    width: 72;
    max-width: 95%;
    height: auto;
    max-height: 90%;
    padding: 1 2;
}
HelpScreen .help-title { text-style: bold; color: $accent; }
HelpScreen .help-category { text-style: bold; color: $text; }
HelpScreen .help-row { color: $text-muted; }
HelpScreen .help-spacer { height: 1; }
HelpScreen .help-hint { color: $text-muted; text-style: italic; }

/* Musical context stays compact beside the waveform; i exposes all metadata. */
TopDisplayWidget .embedded-panel {
    dock: right;
    width: 48%;
    height: 1fr;
    border-left: solid $panel-lighten-2;
    padding-left: 1;
    margin-left: 1;
    overflow-x: hidden;
}
.embedded-title {
    height: 1;
    text-style: bold;
    color: $accent;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}
.embedded-values {
    height: auto;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    color: $text;
}
